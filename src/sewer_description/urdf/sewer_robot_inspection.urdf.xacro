<?xml version="1.0"?>
<!-- Inspection variant of the sewer robot (Account 2): the UNCHANGED base robot (sewer_robot.urdf.xacro) plus
     - a depth camera on camera_link (same pose/FOV as the RGB robot_cam), 320x180 @ 5 Hz      (SIMULATED by Gazebo)
     - a 5-joint arm (turret yaw +-1.9 rad, shoulder/elbow/wrist pitch, links 0.32 + 0.30 m, wrist yaw +-1.7 rad) on a
       short mast above the LiDAR, and a two-finger
       parallel gripper with contact sensors on both fingers                                     (SIMULATED by Gazebo)
     - Gazebo JointPositionController per joint (topics arm/<joint>/cmd, std_msgs/Float64 via ros_gz_bridge) and a
       JointStatePublisher for the arm joints on the same joint_states topic as the wheels
   Geometry must match sewer_manipulation/arm_kinematics.py (ArmGeometry). The base model, its sensors and plugins
   are included as they are; this file only ADDS links, joints, sensors and plugins. Lead approval needed before
   this robot replaces the base one in shared launch files. -->
<robot name="sewer_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="sewer_robot.urdf.xacro"/>

  <xacro:property name="l1" value="0.32"/>
  <xacro:property name="l2" value="0.30"/>
  <xacro:property name="link_t" value="0.025"/>
  <xacro:property name="finger_len" value="0.07"/>
  <xacro:property name="finger_t" value="0.012"/>
  <xacro:property name="finger_h" value="0.04"/>
  <xacro:property name="finger_max" value="0.055"/>
  <xacro:property name="g_tip" value="0.06"/>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>

  <!-- ===== depth camera (same frame and hfov as robot_cam; planar depth in metres) ===== -->
  <gazebo reference="camera_link">
    <sensor name="robot_depth" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <topic>robot_depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5</horizontal_fov>
        <image><width>320</width><height>180</height><format>R_FLOAT32</format></image>
        <clip><near>0.1</near><far>5.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===== arm ===== -->
  <link name="arm_mast_link">
    <visual><origin xyz="0 0 0.015"/><geometry><cylinder radius="0.018" length="0.03"/></geometry>
      <material name="arm_grey"><color rgba="0.25 0.25 0.28 1"/></material></visual>
    <collision><origin xyz="0 0 0.015"/><geometry><cylinder radius="0.018" length="0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 0.015"/><mass value="0.05"/><xacro:cyl_inertia m="0.05" r="0.018" h="0.03"/></inertial>
  </link>
  <!-- On top of the LiDAR housing (lidar_link at z 0.07, housing top at 0.09): nothing of the folded arm is in the scan plane. -->
  <joint name="arm_mast_joint" type="fixed">
    <parent link="base_link"/><child link="arm_mast_link"/><origin xyz="0.05 0 0.09"/>
  </joint>

  <link name="arm_turret_link">
    <visual><origin xyz="0 0 0.005"/><geometry><cylinder radius="0.025" length="0.02"/></geometry>
      <material name="arm_grey"/></visual>
    <collision><origin xyz="0 0 0.005"/><geometry><cylinder radius="0.025" length="0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 0.005"/><mass value="0.05"/><xacro:cyl_inertia m="0.05" r="0.025" h="0.02"/></inertial>
  </link>
  <joint name="arm_turret_joint" type="revolute">
    <parent link="arm_mast_link"/><child link="arm_turret_link"/><origin xyz="0 0 0.03"/><axis xyz="0 0 1"/>
    <limit lower="-1.9" upper="1.9" effort="5" velocity="1.5"/><dynamics damping="0.2"/>
  </joint>

  <xacro:macro name="arm_link" params="name length mass rgba">
    <link name="${name}">
      <visual><origin xyz="${length/2} 0 0"/><geometry><box size="${length} ${link_t} ${link_t}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material></visual>
      <collision><origin xyz="${length/2} 0 0"/><geometry><box size="${length} ${link_t} ${link_t}"/></geometry></collision>
      <inertial><origin xyz="${length/2} 0 0"/><mass value="${mass}"/>
        <inertia ixx="${mass*2*link_t*link_t/12}" ixy="0" ixz="0" iyy="${mass*(length*length+link_t*link_t)/12}" iyz="0"
                 izz="${mass*(length*length+link_t*link_t)/12}"/></inertial>
    </link>
  </xacro:macro>
  <xacro:arm_link name="arm_upper_link" length="${l1}" mass="0.18" rgba="0.95 0.45 0.05 1"/>
  <xacro:arm_link name="arm_fore_link" length="${l2}" mass="0.15" rgba="0.95 0.45 0.05 1"/>

  <!-- pitch joints: +angle points the link DOWN (rotation about +y) -->
  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="arm_turret_link"/><child link="arm_upper_link"/><origin xyz="0 0 0.01"/><axis xyz="0 1 0"/>
    <limit lower="-2.7" upper="1.6" effort="20" velocity="1.5"/><dynamics damping="0.3"/>
  </joint>
  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_upper_link"/><child link="arm_fore_link"/><origin xyz="${l1} 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="12" velocity="1.5"/><dynamics damping="0.3"/>
  </joint>

  <link name="gripper_link">
    <visual><origin xyz="0.0125 0 0"/><geometry><box size="0.025 0.13 0.04"/></geometry>
      <material name="arm_grey"/></visual>
    <collision><origin xyz="0.0125 0 0"/><geometry><box size="0.025 0.13 0.04"/></geometry></collision>
    <inertial><origin xyz="0.0125 0 0"/><mass value="0.10"/>
      <inertia ixx="1.6e-4" ixy="0" ixz="0" iyy="1.9e-5" iyz="0" izz="1.5e-4"/></inertial>
  </link>
  <link name="arm_wrist_link">
    <visual><geometry><cylinder radius="0.018" length="0.03"/></geometry><material name="arm_grey"/></visual>
    <collision><geometry><cylinder radius="0.018" length="0.03"/></geometry></collision>
    <inertial><mass value="0.04"/><xacro:cyl_inertia m="0.04" r="0.018" h="0.03"/></inertial>
  </link>
  <joint name="arm_wrist_joint" type="revolute">
    <parent link="arm_fore_link"/><child link="arm_wrist_link"/><origin xyz="${l2} 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="5" velocity="2.0"/><dynamics damping="0.1"/>
  </joint>
  <!-- wrist yaw: turns the gripper about its vertical axis so the fingers close across the object's narrow side
       whatever direction the robot faces (the Mission Manager always stops facing along the corridor) -->
  <joint name="arm_wrist_yaw_joint" type="revolute">
    <parent link="arm_wrist_link"/><child link="gripper_link"/><origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.7" upper="1.7" effort="3" velocity="2.0"/><dynamics damping="0.05"/>
  </joint>

  <!-- fingers: inner face at y = +q (left) / -q (right); opening = q_left + q_right -->
  <xacro:macro name="finger" params="side sign">
    <link name="${side}_finger_link">
      <visual><origin xyz="0 ${sign*finger_t/2} 0"/><geometry><box size="${finger_len} ${finger_t} ${finger_h}"/></geometry>
        <material name="finger_mat"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <collision><origin xyz="0 ${sign*finger_t/2} 0"/><geometry><box size="${finger_len} ${finger_t} ${finger_h}"/></geometry></collision>
      <inertial><origin xyz="0 ${sign*finger_t/2} 0"/><mass value="0.03"/>
        <inertia ixx="4.4e-6" ixy="0" ixz="0" iyy="1.6e-5" iyz="0" izz="1.3e-5"/></inertial>
    </link>
    <joint name="${side}_finger_joint" type="prismatic">
      <parent link="gripper_link"/><child link="${side}_finger_link"/><origin xyz="${g_tip} 0 0"/>
      <axis xyz="0 ${sign} 0"/><limit lower="0" upper="${finger_max}" effort="20" velocity="0.2"/>
      <dynamics damping="1.0"/>
    </joint>
    <gazebo reference="${side}_finger_link"><mu1>1.5</mu1><mu2>1.5</mu2><kp>100000</kp><kd>10</kd></gazebo>
    <xacro:contact_sensor link="${side}_finger_link" collision="${side}_finger_link_collision"/>
  </xacro:macro>
  <xacro:finger side="left" sign="1"/>
  <xacro:finger side="right" sign="-1"/>

  <!-- ===== Gazebo joint controllers (SIMULATED). Gains are first guesses: tune in Gazebo (see ACCOUNT2_README). ===== -->
  <xacro:macro name="pos_ctl" params="joint topic p i d cmd_max init">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
        <p_gain>${p}</p_gain><i_gain>${i}</i_gain><d_gain>${d}</d_gain>
        <i_max>${cmd_max/2}</i_max><i_min>${-cmd_max/2}</i_min>
        <cmd_max>${cmd_max}</cmd_max><cmd_min>${-cmd_max}</cmd_min>
        <initial_position>${init}</initial_position>
      </plugin>
    </gazebo>
  </xacro:macro>
  <!-- initial positions = the stow pose from arm_kinematics.ik(ArmGeometry().stow) -->
  <xacro:pos_ctl joint="arm_turret_joint"   topic="arm/turret/cmd"   p="20"  i="1"  d="1.0" cmd_max="5"  init="0.0"/>
  <xacro:pos_ctl joint="arm_shoulder_joint" topic="arm/shoulder/cmd" p="50"  i="12" d="2.5" cmd_max="20" init="-2.539"/>
  <xacro:pos_ctl joint="arm_elbow_joint"    topic="arm/elbow/cmd"    p="35"  i="8"  d="1.5" cmd_max="12" init="2.745"/>
  <xacro:pos_ctl joint="arm_wrist_joint"    topic="arm/wrist/cmd"    p="10"  i="2"  d="0.5" cmd_max="5"  init="-0.206"/>
  <xacro:pos_ctl joint="arm_wrist_yaw_joint" topic="arm/wrist_yaw/cmd" p="6"   i="1"  d="0.3" cmd_max="3"  init="0.0"/>
  <xacro:pos_ctl joint="left_finger_joint"  topic="arm/left_finger/cmd"  p="600" i="0" d="10" cmd_max="15" init="0.04"/>
  <xacro:pos_ctl joint="right_finger_joint" topic="arm/right_finger/cmd" p="600" i="0" d="10" cmd_max="15" init="0.04"/>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>arm_turret_joint</joint_name>
      <joint_name>arm_shoulder_joint</joint_name>
      <joint_name>arm_elbow_joint</joint_name>
      <joint_name>arm_wrist_joint</joint_name>
      <joint_name>arm_wrist_yaw_joint</joint_name>
      <joint_name>left_finger_joint</joint_name>
      <joint_name>right_finger_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
