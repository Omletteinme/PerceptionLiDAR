<?xml version="1.0"?>
<package format="3">
  <name>sewer_planning</name>
  <version>0.1.0</version>
  <description>Uncertainty-aware route planning on the sewer graph: pure NumPy core plus planner and follower nodes.</description>
  <maintainer email="jeeviteshmishra26@gmail.com">jeevi</maintainer>
  <license>MIT</license>
  <exec_depend>sewer_localization</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
